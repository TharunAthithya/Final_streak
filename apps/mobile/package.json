{
  "name": "@streak/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "cross-env APP_ENV=development expo start",
    "dev": "cross-env APP_ENV=development expo start",
    "dev:prod": "cross-env APP_ENV=production expo start",
    "android": "cross-env APP_ENV=development expo start --android",
    "android:prod": "cross-env APP_ENV=production expo start --android",
    "ios": "cross-env APP_ENV=development expo start --ios",
    "web": "cross-env APP_ENV=development expo start --web",
    "build:development": "eas build --platform android --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "ts:check": "tsc"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.19",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@streak/api-client": "workspace:*",
    "@streak/contracts": "workspace:*",
    "@streak/design-tokens": "workspace:*",
    "@streak/validation": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~56.0.19",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.23",
    "expo-font": "~56.0.7",
    "expo-haptics": "^56.0.3",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
