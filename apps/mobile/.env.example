# =========================================================================
# Final Streak Mobile App - Environment Variables Template
# =========================================================================
# Copy this file to '.env' or '.env.local' in the same folder and fill in
# your Supabase credentials. Do not commit your actual credentials to Git!

# Your Supabase Project API URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Your Supabase Anon (public) API Key
# Found in: Supabase Dashboard -> Project Settings -> API -> anon public key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
