{
  "name": "streak-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @streak/mobile dev",
    "android": "pnpm --filter @streak/mobile android",
    "ios": "pnpm --filter @streak/mobile ios",
    "build:development": "pnpm --filter @streak/mobile build:development",
    "build:preview": "pnpm --filter @streak/mobile build:preview",
    "build:production": "pnpm --filter @streak/mobile build:production",
    "build:android:preview": "pnpm --filter @streak/mobile build:android:preview",
    "build:ios:preview": "pnpm --filter @streak/mobile build:ios:preview",
    "build:ios:simulator": "pnpm --filter @streak/mobile build:ios:simulator",
    "build:all:preview": "pnpm --filter @streak/mobile build:all:preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
